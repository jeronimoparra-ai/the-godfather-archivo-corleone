# ==============================================
# Variables de Entorno - The Godfather Bootstrap
# ==============================================

# Configuración de Supabase para opiniones
# Copia este archivo a .env.local y actualiza con tus credenciales

VITE_SUPABASE_URL=https://tus-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-key-publicable

# Configuración del servidor (si es necesario)
VITE_API_URL=https://api.tu-dominio.com

# Configuración de funcionalidad futura
# VITE_FEATURE_FLAG_NUEVO_COMPONENTE=true

# ==============================================
# BANDA SONORA AMBIENTAL
# ==============================================
# URL pública del archivo de audio autorizado (mp3, ogg, aac, wav).
# Deja en blanco si no dispones de una fuente con autorización de uso.
# El reproductor mostrará el estado "Fuente no configurada" mientras
# esta variable esté vacía.
#
# Fuentes autorizadas posibles:
#   - Archivos propios con licencia adquirida
#   - Internet Archive (obras de dominio público)
#   - Jamendo u otras plataformas de música Creative Commons
#
# Ejemplo (NO usar grabaciones comerciales sin autorización):
# VITE_SOUNDTRACK_URL=https://cdn.ejemplo.com/audio/the-godfather-waltz.mp3
VITE_SOUNDTRACK_URL=

# Configuración de apariencia (opcional)
# VITE_COLOR_SCHEME=dark
# VITE_FONT_FAMILY=serif

# ==============================================
# INSTRUCCIONES DE SEGURIDAD:
# ==============================================
# 1. Nunca subir .env al control de versiones Git
# 2. Agregar .env a .gitignore
# 3. .env.example debe contener plantillas, no claves reales
# 4. Las claves privadas (secretas del servidor) no deben almacenarse en frontend
# ==============================================